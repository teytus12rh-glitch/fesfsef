<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_obsidian"
    android:padding="16dp">

    <!-- BARRA LATERAL -->
    <LinearLayout
        android:id="@+id/sidebarNav"
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/containerCreatorBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tv_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leandro Corrêa"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRIADOR"
                android:background="@drawable/bg_badge_creator"
                android:textColor="@color/cyan_neon"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAUNCHER"
                android:textColor="@color/cyan_neon"
                android:textSize="8sp"
                android:letterSpacing="0.2"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/menuInicio"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🏠 Início"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_card_focused"
            android:focusable="true"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/menuFilmes"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🎬 Filmes"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/menuSeries"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="📺 Séries"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/menuApps"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="📱 Apps"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/menuConfig"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="⚙️ Ajustes"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boa diversão!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Pressione OK"
            android:textColor="@color/cyan_neon"
            android:textSize="9sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ÁREA PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <!-- CABEÇALHO COM RELÓGIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnMute"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔇 Mudo"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnTvMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎮 Controle TV"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnMobileMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="📱 Modo Celular"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHeaderClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:42"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sábado\n27 de Setembro de 2026"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- WIDGET CLIMA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_card"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛅ 22°C\nParcialmente nublado • Jacarezinho - PR"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Umidade 72% | Vento 12 km/h | UV 5"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&quot;Grandes coisas levam tempo...&quot;"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="italic"
                android:layout_marginStart="20dp" />
        </LinearLayout>

        <!-- APPS FAVORITOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/cardFlixCine"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:text="▶ FLIXCINE\nFilmes e Séries"
                android:gravity="center"
                android:textColor="#FF2244"
                android:textSize="12sp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true" />

            <TextView
                android:id="@+id/cardYouTube"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:text="▶ YouTube (4K HDR)\nVídeos"
                android:gravity="center"
                android:textColor="@color/cyan_neon"
                android:textSize="12sp"
                android:background="@drawable/bg_glass_card_focused"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/cardTclChannel"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:text="TCL CHANNEL\nCanais de TV"
                android:gravity="center"
                android:textColor="#FF4444"
                android:textSize="12sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/cardMoreApps"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:text="⊞ Mais Apps"
                android:gravity="center"
                android:textColor="@color/cyan_neon"
                android:textSize="13sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/cardAddFavorite"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:text="＋ Favorito"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- ENTRADAS HDMI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnHdmi1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔌 HDMI 1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnHdmi2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔌 HDMI 2 (eARC) ●"
                android:gravity="center"
                android:textColor="@color/green_status"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="10dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnHdmi3"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔌 HDMI 3"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="10dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- FILEIRA DE POSTERES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="THE LAST OF US\n▶ Série"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="WICKED\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEADPOOL 3\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="GLADIADOR II\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="STRANGER THINGS\n▶ Série"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DUNA: PARTE 2\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
