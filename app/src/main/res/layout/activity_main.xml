<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_obsidian"
    android:padding="12dp">

    <!-- ==================== MENU LATERAL ESQUERDO ==================== -->
    <LinearLayout
        android:id="@+id/sidebarNav"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="10dp"
        android:gravity="center_horizontal">

        <!-- LOGO LEANDRO CORRÊA [CRIADOR] -->
        <LinearLayout
            android:id="@+id/containerCreatorBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="📺"
                android:gravity="center"
                android:textSize="20sp"
                android:background="@drawable/bg_glass_card_focused" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leandro Corrêa"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRIADOR"
                        android:background="@drawable/bg_badge_creator"
                        android:textColor="@color/cyan_neon"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="L A U N C H E R"
                    android:textColor="@color/cyan_neon"
                    android:textSize="8sp"
                    android:letterSpacing="0.15" />
            </LinearLayout>
        </LinearLayout>

        <!-- ITENS DO MENU -->
        <TextView
            android:id="@+id/menuInicio"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🏠  Início"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_glass_card_focused"
            android:focusable="true"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/menuFilmes"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🎬  Filmes"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/menuSeries"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="📺  Séries"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/menuApps"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="⊞  Aplicativos"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/menuConfig"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="⚙️  Configurações"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/selector_tv_card"
            android:focusable="true"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boa diversão!"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Pressione OK para navegar"
            android:textColor="@color/cyan_neon"
            android:textSize="9sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ==================== CONTEÚDO PRINCIPAL ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 1. TOPO: BOTÕES, RELÓGIO E DATA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnMute"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="🔇 Mudo"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnTvMode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="🎮 Controle TV"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnMobileMode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="📱 Modo Celular"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="⬇ Baixar APK"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/bg_btn_download"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHeaderClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:42"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sábado\n27 de Setembro de 2026"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginStart="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 📶 ⚙"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 2. WIDGET DE CLIMA RICO COM 3 COLUNAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_card"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- Coluna 1: Temperatura e Local -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛅"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22°C"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parcialmente nublado"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Jacarezinho - PR"
                        android:textColor="@color/cyan_neon"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />

            <!-- Coluna 2: Previsão 5 dias -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoje ☀️ 23°/16°  |  Dom ☀️ 25°/17°  |  Seg 🌧 24°/18°  |  Ter ☀️ 26°/19°"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Coluna 3: Métricas e Citação -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Umidade 72% | Vento 12 km/h | UV 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;Grandes coisas levam tempo...&quot;"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. FILEIRA DE APPS COM BADGES GRÁFICOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- FLIXCINE -->
            <LinearLayout
                android:id="@+id/cardFlixCine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_flixcine"
                android:focusable="true" />

            <!-- YOUTUBE (COM FOCO NEON) -->
            <LinearLayout
                android:id="@+id/cardYouTube"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_youtube"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <!-- TCL CHANNEL -->
            <LinearLayout
                android:id="@+id/cardTclChannel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_tcl"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <!-- MAIS APPS -->
            <LinearLayout
                android:id="@+id/cardMoreApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⊞"
                    android:textColor="@color/cyan_neon"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mais Apps"
                    android:textColor="@color/cyan_neon"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- + FAVORITO -->
            <LinearLayout
                android:id="@+id/cardAddFavorite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Favorito"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. FILEIRA ENTRADAS HDMI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnHdmi1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🔌 HDMI 1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnHdmi2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🔌 HDMI 2 (eARC) ●"
                android:gravity="center"
                android:textColor="@color/green_status"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnHdmi3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🔌 HDMI 3"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/selector_tv_card"
                android:layout_marginStart="8dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- 5. FILEIRA POSTERES CINEMATOGRÁFICOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/poster1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="THE LAST OF US\n▶ Série"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/poster_last_of_us"
                android:focusable="true" />

            <TextView
                android:id="@+id/poster2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="WICKED\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/poster_wicked"
                android:layout_marginStart="6dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/poster3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEADPOOL 3\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/poster_deadpool"
                android:layout_marginStart="6dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/poster4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="GLADIADOR II\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/poster_gladiador"
                android:layout_marginStart="6dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/poster5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="STRANGER THINGS\n▶ Série"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/poster_stranger_things"
                android:layout_marginStart="6dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/poster6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DUNA: PARTE 2\n▶ Filme"
                android:gravity="bottom|center_horizontal"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/poster_duna"
                android:layout_marginStart="6dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
