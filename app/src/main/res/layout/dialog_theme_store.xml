<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_glass_card_focused">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎨 Temas Gratuitos para sua TV"
        android:textColor="@color/cyan_neon"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha um estilo moderno com 1 clique para transformar as cores e a ambiência:"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThemesList"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnCloseThemeStore"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:text="Fechar"
        android:textColor="@color/bg_obsidian"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_download"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp" />
</LinearLayout>
